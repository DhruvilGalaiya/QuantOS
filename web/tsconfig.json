{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "noEmit": true, "types": ["vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
