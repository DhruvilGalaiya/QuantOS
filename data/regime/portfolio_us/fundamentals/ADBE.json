wered applications. The company was formerly known as Adobe Systems Incorporated and changed its name to Adobe Inc. in October 2018. Adobe Inc. was founded in 1982 and is headquartered in San Jose, California.", "sector": "Technology", "industry": "Software - Application", "employees": 31360.0, "city": "San Jose", "state": "CA", "country": "United States", "price": 231.6, "change_pct": -0.20687689, "quote_time": 1795620066.0, "market_cap": 90138722304.0, "net_assets": null, "high_52w": 362.71, "low_52w": 190.12, "pe": 12.931324, "forward_pe": 8.45034, "eps": 17.91, "book_value": 30.087, "price_to_book": 7.697676737461362, "dividend_yield": 0.0, "roce": 0.5273310119935887, "roe": 0.61902, "roa": 0.20075001, "net_margin": 0.28048, "operating_margin": 0.36323002, "revenue_growth": 0.129, "earnings_growth": 0.105, "debt_to_equity": 0.5769299999999999, "current_ratio": 0.77, "beta": 1.383}, "financials": {"quarterly": {"columns": ["Aug 2025", "Nov 2025", "Feb 2026", "May 2026", "Aug 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [5988000000.0, 6194000000.0, 6398000000.0, 6618000000.0, 6760000000.0]}, {"label": "Cost of Revenue", "kind": "money", "bold": false, "values": [642000000.0, 649000000.0, 664000000.0, 715000000.0, 763000000.0]}, {"label": "Gross Profit", "kind": "money", "bold": true, "values": [5346000000.0, 5545000000.0, 5734000000.0, 5903000000.0, 5997000000.0]}, {"label": "Gross Margin %", "kind": "pct", "bold": false, "values": [0.8927855711422845, 0.8952211817888279, 0.8962175679899969, 0.8919613176186159, 0.887130177514793]}, {"label": "R&D", "kind": "money", "bold": false, "values": [1088000000.0, 1098000000.0, 1110000000.0, 1198000000.0, 1288000000.0]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [2047000000.0, 2149000000.0, 2171000000.0, 2430000000.0, 2315000000.0]}, {"label": "Operating Expenses", "kind": "money", "bold": false, "values": [3173000000.0, 3284000000.0, 3316000000.0, 3665000000.0, 364300000