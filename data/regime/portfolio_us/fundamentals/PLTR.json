elligent engine for running NVIDIA AI and Nemotron open models in sovereign environments and with PwC to transform critical business operations and deliver measurable enterprise value. The company was incorporated in 2003 and is headquartered in Aventura, Florida.", "sector": "Technology", "industry": "Software - Infrastructure", "employees": 4634.0, "city": "Aventura", "state": "FL", "country": "United States", "price": 154.755, "change_pct": -3.9862192, "quote_time": 1795619770.0, "market_cap": 372881817600.0, "net_assets": null, "high_52w": 212.94, "low_52w": 106.37, "pe": 108.9824, "forward_pe": 60.956688, "eps": 1.42, "book_value": 4.661, "price_to_book": 33.2021025531002, "dividend_yield": 0.0, "roce": 0.28636819149980286, "roe": 0.40907001, "roa": 0.19313999, "net_margin": 0.50343, "operating_margin": 0.45638, "revenue_growth": 0.959, "earnings_growth": 1.444, "debt_to_equity": 0.01986, "current_ratio": 7.102, "beta": 1.61}, "financials": {"quarterly": {"columns": ["Sep 2025", "Dec 2025", "Mar 2026", "Jun 2026", "Sep 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [1181092000.0, 1406802000.0, 1632583000.0, 1935464000.0, 2313411000.0]}, {"label": "Cost of Revenue", "kind": "money", "bold": false, "values": [207307000.0, 215966000.0, 215798000.0, 296870000.0, 383286000.0]}, {"label": "Gross Profit", "kind": "money", "bold": true, "values": [973785000.0, 1190836000.0, 1416785000.0, 1638594000.0, 1930125000.0]}, {"label": "Gross Margin %", "kind": "pct", "bold": false, "values": [0.8244785334249999, 0.8464844377531451, 0.8678180527421883, 0.8466155919200771, 0.8343199716781843]}, {"label": "R&D", "kind": "money", "bold": false, "values": [144191000.0, null, 160981000.0, 192513000.0, 219720000.0]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [436338000.0, 471888000.0, 501806000.0, 534077000.0, 625560000.0]}, {"label": "Operating Expenses", "kind": "money", "bold": false, "values": [580529000.0, 615442000.0, 662787000