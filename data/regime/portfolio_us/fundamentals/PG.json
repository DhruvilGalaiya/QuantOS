utors, wholesalers, airport duty-free and high-frequency stores, pharmacies, electronics stores, and professional channels, as well as directly to consumers. The company was founded in 1837 and is headquartered in Cincinnati, Ohio.", "sector": "Consumer Defensive", "industry": "Household & Personal Products", "employees": 104000.0, "city": "Cincinnati", "state": "OH", "country": "United States", "price": 173.22, "change_pct": 0.43485823, "quote_time": 1795619766.0, "market_cap": 401486381056.0, "net_assets": null, "high_52w": 173.6, "low_52w": 137.62, "pe": 26.08735, "forward_pe": 23.326088, "eps": 6.64, "book_value": 23.449, "price_to_book": 7.3870953985244565, "dividend_yield": 0.0252, "roce": 0.24130888626667876, "roe": 0.29609, "roa": 0.104890004, "net_margin": 0.18229, "operating_margin": 0.24885, "revenue_growth": 0.04, "earnings_growth": 0.008, "debt_to_equity": 0.70343, "current_ratio": 0.722, "beta": 0.361}, "financials": {"quarterly": {"columns": ["Sep 2025", "Dec 2025", "Mar 2026", "Jun 2026", "Sep 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [22386000000.0, 22208000000.0, 21235000000.0, 21204000000.0, 23276000000.0]}, {"label": "Cost of Revenue", "kind": "money", "bold": false, "values": [10887000000.0, 10834000000.0, 10722000000.0, 10920000000.0, 11678000000.0]}, {"label": "Gross Profit", "kind": "money", "bold": true, "values": [11499000000.0, 11374000000.0, 10513000000.0, 10284000000.0, 11598000000.0]}, {"label": "Gross Margin %", "kind": "pct", "bold": false, "values": [0.5136692575716966, 0.5121577809798271, 0.4950788792088533, 0.48500282965478214, 0.49828149166523455]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [5643000000.0, 6008000000.0, 5936000000.0, 6334000000.0, 5661000000.0]}, {"label": "Operating Expenses", "kind": "money", "bold": false, "values": [5643000000.0, 6008000000.0, 5936000000.0, 6334000000.0, 5661000000.0]}, {"label": "Operating Profit", "kind": "money", "bold": true, "values":