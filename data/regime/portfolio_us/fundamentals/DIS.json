es; operates a direct-to-home satellite distribution platform; sells branded merchandise through retail, online, and wholesale businesses; and develops and publishes books, comic books, and magazines. The company was founded in 1923 and is based in Burbank, California.", "sector": "Communication Services", "industry": "Entertainment", "employees": 180180.0, "city": "Burbank", "state": "CA", "country": "United States", "price": 121.48, "change_pct": -0.8407467, "quote_time": 1795619863.0, "market_cap": 207491448832.0, "net_assets": null, "high_52w": 123.37, "low_52w": 92.19, "pe": 21.577265, "forward_pe": 14.171408, "eps": 5.63, "book_value": 64.323, "price_to_book": 1.8885935046561886, "dividend_yield": 0.0163, "roce": 0.09413015166646227, "roe": 0.09127, "roa": 0.0525, "net_margin": 0.09672, "operating_margin": 0.16565001, "revenue_growth": 0.155, "earnings_growth": 1.073, "debt_to_equity": 0.40340000000000004, "current_ratio": 0.741, "beta": 1.426}, "financials": {"quarterly": {"columns": ["Sep 2025", "Dec 2025", "Mar 2026", "Jun 2026", "Sep 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [22464000000.0, 25981000000.0, 25168000000.0, 25248000000.0, 25947000000.0]}, {"label": "Cost of Revenue", "kind": "money", "bold": false, "values": [14018000000.0, 16669000000.0, 15901000000.0, 15106000000.0, 15754000000.0]}, {"label": "Gross Profit", "kind": "money", "bold": true, "values": [8446000000.0, 9312000000.0, 9267000000.0, 10142000000.0, 10193000000.0]}, {"label": "Gross Margin %", "kind": "pct", "bold": false, "values": [0.37597934472934474, 0.358415765366999, 0.3682056579783852, 0.4016951837769328, 0.392839249238833]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [4449000000.0, 4121000000.0, 4073000000.0, 3968000000.0, 4650000000.0]}, {"label": "Operating Expenses", "kind": "money", "bold": false, "values": [5843000000.0, 5437000000.0, 5478000000.0, 5382000000.0, 6120000000.0]}, {"label": "Operating Profit", "kind": "mo