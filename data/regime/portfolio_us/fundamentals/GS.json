her services, such as deposit-taking, payment solutions, and other cash management services for corporate and institutional clients. The Goldman Sachs Group, Inc. was founded in 1869 and is headquartered in New York, New York.", "sector": "Financial Services", "industry": "Capital Markets", "employees": 47500.0, "city": "New York", "state": "NY", "country": "United States", "price": 775.37, "change_pct": -3.802638, "quote_time": 1795619826.0, "market_cap": 223643533312.0, "net_assets": null, "high_52w": 1153.99, "low_52w": 772.74, "pe": 11.148382, "forward_pe": 10.428759, "eps": 69.55, "book_value": 366.927, "price_to_book": 2.113145121509183, "dividend_yield": 0.0248, "roce": null, "roe": 0.17712, "roa": 0.01112, "net_margin": 0.31208, "operating_margin": 0.39498, "revenue_growth": 0.233, "earnings_growth": 0.388, "debt_to_equity": 7.5601400000000005, "current_ratio": 1.606, "beta": 1.272}, "financials": {"quarterly": {"columns": ["Jun 2025", "Sep 2025", "Dec 2025", "Mar 2026", "Sep 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [14583000000.0, 15184000000.0, 13454000000.0, 17227000000.0, 18679000000.0]}, {"label": "Interest Income", "kind": "money", "bold": false, "values": [19789000000.0, 20822000000.0, 20379000000.0, 20637000000.0, 22793000000.0]}, {"label": "Interest Expense", "kind": "money", "bold": false, "values": [16685000000.0, 16970000000.0, 16671000000.0, 17082000000.0, 19023000000.0]}, {"label": "Net Interest Income", "kind": "money", "bold": true, "values": [3104000000.0, 3852000000.0, 3708000000.0, 3555000000.0, 3770000000.0]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [4852000000.0, 4851000000.0, 4881000000.0, 5598000000.0, 5305000000.0]}, {"label": "Profit before Tax", "kind": "money", "bold": true, "values": [4958000000.0, 5392000000.0, 5855000000.0, 6486000000.0, 7003000000.0]}, {"label": "Tax %", "kind": "pct", "bold": false, "values": [0.2490923759580476, 0.23998516320474778, 0.2114432109308283