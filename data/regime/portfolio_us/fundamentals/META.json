icro Devices, Inc., Broadcom Inc., and OpenAI, L.L.C. The company was formerly known as Facebook, Inc. and changed its name to Meta Platforms, Inc. in October 2021. The company was incorporated in 2004 and is headquartered in Menlo Park, California.", "sector": "Communication Services", "industry": "Internet Content & Information", "employees": 66775.0, "city": "Menlo Park", "state": "CA", "country": "United States", "price": 579.545, "change_pct": -1.742061, "quote_time": 1795619702.0, "market_cap": 1481456746496.0, "net_assets": null, "high_52w": 779.82, "low_52w": 520.26, "pe": 19.772943, "forward_pe": 16.298592, "eps": 29.31, "book_value": 106.567, "price_to_book": 5.438315801326865, "dividend_yield": 0.0036, "roce": 0.1963349966933205, "roe": 0.32264, "roa": 0.14577, "net_margin": 0.31145, "operating_margin": 0.37777, "revenue_growth": 0.261, "earnings_growth": 2.648, "debt_to_equity": 0.42161000000000004, "current_ratio": 1.903, "beta": 1.279}, "financials": {"quarterly": {"columns": ["Sep 2025", "Dec 2025", "Mar 2026", "Jun 2026", "Sep 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [51242000000.0, 59893000000.0, 56311000000.0, 60801000000.0, 64601000000.0]}, {"label": "Cost of Revenue", "kind": "money", "bold": false, "values": [9206000000.0, 10906000000.0, 10218000000.0, 11330000000.0, 13369000000.0]}, {"label": "Gross Profit", "kind": "money", "bold": true, "values": [42036000000.0, 48987000000.0, 46093000000.0, 49471000000.0, 51232000000.0]}, {"label": "Gross Margin %", "kind": "pct", "bold": false, "values": [0.820342687639046, 0.8179086036765565, 0.8185434462183232, 0.8136543806845282, 0.7930527391216854]}, {"label": "R&D", "kind": "money", "bold": false, "values": [15144000000.0, 17135000000.0, 17699000000.0, 21656000000.0, 20054000000.0]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [6357000000.0, 7107000000.0, 5522000000.0, 9040000000.0, 18190000000.0]}, {"label": "Operating Expenses", "kind": "money", 