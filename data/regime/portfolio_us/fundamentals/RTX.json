ntrol products, and software. The company was formerly known as Raytheon Technologies Corporation and changed its name to RTX Corporation in July 2023. RTX Corporation was incorporated in 1934 and is headquartered in Arlington, Virginia.", "sector": "Industrials", "industry": "Aerospace & Defense", "employees": 180000.0, "city": "Arlington", "state": "VA", "country": "United States", "price": 194.115, "change_pct": -0.6220224, "quote_time": 1795619811.0, "market_cap": 261946654720.0, "net_assets": null, "high_52w": 226.88, "low_52w": 166.74, "pe": 31.563416, "forward_pe": 23.989605, "eps": 6.15, "book_value": 51.318, "price_to_book": 3.782590903776453, "dividend_yield": 0.0149, "roce": 0.11002839556253197, "roe": 0.1285, "roa": 0.045560002, "net_margin": 0.08754, "operating_margin": 0.13109, "revenue_growth": 0.111, "earnings_growth": 0.34, "debt_to_equity": 0.5475800000000001, "current_ratio": 1.045, "beta": 0.282}, "financials": {"quarterly": {"columns": ["Sep 2025", "Dec 2025", "Mar 2026", "Jun 2026", "Sep 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [22478000000.0, 24238000000.0, 22076000000.0, 24708000000.0, 24965000000.0]}, {"label": "Cost of Revenue", "kind": "money", "bold": false, "values": [17898000000.0, 19521000000.0, 17482000000.0, 19575000000.0, 19160000000.0]}, {"label": "Gross Profit", "kind": "money", "bold": true, "values": [4580000000.0, 4717000000.0, 4594000000.0, 5133000000.0, 5805000000.0]}, {"label": "Gross Margin %", "kind": "pct", "bold": false, "values": [0.20375478245395498, 0.19461176664741314, 0.2080992933502446, 0.20774647887323944, 0.23252553575005008]}, {"label": "R&D", "kind": "money", "bold": false, "values": [684000000.0, 789000000.0, 627000000.0, 726000000.0, 711000000.0]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [1436000000.0, 1638000000.0, 1476000000.0, 1658000000.0, 1918000000.0]}, {"label": "Operating Expenses", "kind": "money", "bold": false, "values": [2057000000.0, 2121