 names. Mastercard Incorporated was founded in 1966 and is headquartered in Purchase, New York.", "sector": "Financial Services", "industry": "Credit Services", "employees": 39800.0, "city": "Purchase", "state": "NY", "country": "United States", "price": 644.93, "change_pct": -0.38768223, "quote_time": 1795619725.0, "market_cap": 561847599104.0, "net_assets": null, "high_52w": 681.99, "low_52w": 464.52, "pe": 33.7483, "forward_pe": 27.846804, "eps": 19.11, "book_value": 7.743, "price_to_book": 83.29200568255197, "dividend_yield": 0.0054, "roce": 0.6399139987629959, "roe": 2.31366, "roa": 0.24451, "net_margin": 0.46732, "operating_margin": 0.60069, "revenue_growth": 0.14, "earnings_growth": 0.217, "debt_to_equity": 3.5516300000000003, "current_ratio": 1.012, "beta": 0.77}, "financials": {"quarterly": {"columns": ["Sep 2025", "Dec 2025", "Mar 2026", "Jun 2026", "Sep 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [8602000000.0, 8806000000.0, 8398000000.0, 9277000000.0, 9807000000.0]}, {"label": "Cost of Revenue", "kind": "money", "bold": false, "values": [1893000000.0, 1818000000.0, 2037000000.0, 1947000000.0, 2028000000.0]}, {"label": "Gross Profit", "kind": "money", "bold": true, "values": [6709000000.0, 6988000000.0, 6361000000.0, 7330000000.0, 7779000000.0]}, {"label": "Gross Margin %", "kind": "pct", "bold": false, "values": [0.7799348988607301, 0.7935498523733818, 0.7574422481543225, 0.7901261183572276, 0.7932089323952279]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [1249000000.0, 1562000000.0, 1097000000.0, 1293000000.0, 1475000000.0]}, {"label": "Operating Expenses", "kind": "money", "bold": false, "values": [1539000000.0, 1859000000.0, 1396000000.0, 1602000000.0, 1801000000.0]}, {"label": "Operating Profit", "kind": "money", "bold": true, "values": [5170000000.0, 5129000000.0, 4965000000.0, 5728000000.0, 5978000000.0]}, {"label": "Operating Margin %", "kind": "pct", "bold": false, "values": [0.6010230179028133