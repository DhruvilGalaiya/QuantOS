; and OpenAI to develop Shirudo, an open source project that helps protect running Linux systems without a reboot. Cisco Systems, Inc. was incorporated in 1984 and is headquartered in San Jose, California.", "sector": "Technology", "industry": "Communication Equipment", "employees": 82400.0, "city": "San Jose", "state": "CA", "country": "United States", "price": 92.2, "change_pct": -1.9044589, "quote_time": 1795619772.0, "market_cap": 363493720064.0, "net_assets": null, "high_52w": 130.37, "low_52w": 72.8, "pe": 24.521276, "forward_pe": 15.241307, "eps": 3.76, "book_value": 13.115, "price_to_book": 7.030118185284026, "dividend_yield": 0.0179, "roce": 0.21779856882528112, "roe": 0.3038, "roa": 0.09077, "net_margin": 0.22341, "operating_margin": 0.27172002, "revenue_growth": 0.244, "earnings_growth": 0.583, "debt_to_equity": 0.60965, "current_ratio": 0.961, "beta": 1.002}, "financials": {"quarterly": {"columns": ["Oct 2025", "Jan 2026", "Apr 2026", "Jul 2026", "Oct 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [14883000000.0, 15349000000.0, 15841000000.0, 17252000000.0, 18517000000.0]}, {"label": "Cost of Revenue", "kind": "money", "bold": false, "values": [5138000000.0, 5377000000.0, 5761000000.0, 6189000000.0, 6729000000.0]}, {"label": "Gross Profit", "kind": "money", "bold": true, "values": [9745000000.0, 9972000000.0, 10080000000.0, 11063000000.0, 11788000000.0]}, {"label": "Gross Margin %", "kind": "pct", "bold": false, "values": [0.654773903110932, 0.6496840185028341, 0.6363234644277508, 0.6412589844655692, 0.6366042015445267]}, {"label": "R&D", "kind": "money", "bold": false, "values": [2400000000.0, 2355000000.0, 2377000000.0, 2431000000.0, 2423000000.0]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [3604000000.0, 3569000000.0, 3516000000.0, 3631000000.0, 3548000000.0]}, {"label": "Operating Expenses", "kind": "money", "bold": false, "values": [6235000000.0, 6155000000.0, 6121000000.0, 6288000000.0, 6162000000.