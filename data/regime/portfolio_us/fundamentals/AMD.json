 Alveo and Pensando brands. It serves original equipment and design manufacturers, public cloud service providers, system integrators, distributors, and add-in-board manufacturers. The company was incorporated in 1969 and is headquartered in Santa Clara, California.", "sector": "Technology", "industry": "Semiconductors", "employees": 31000.0, "city": "Santa Clara", "state": "CA", "country": "United States", "price": 379.42, "change_pct": -8.189874, "quote_time": 1795619729.0, "market_cap": 627965034496.0, "net_assets": null, "high_52w": 658.52, "low_52w": 188.22, "pe": 81.072655, "forward_pe": 21.549433, "eps": 4.68, "book_value": 41.701, "price_to_book": 9.098582767799334, "dividend_yield": 0.0, "roce": 0.10294300724547469, "roe": 0.1196, "roa": 0.05895, "net_margin": 0.16769, "operating_margin": 0.17820999, "revenue_growth": 0.447, "earnings_growth": 0.938, "debt_to_equity": 0.13469, "current_ratio": 2.725, "beta": 2.542}, "financials": {"quarterly": {"columns": ["Sep 2025", "Dec 2025", "Mar 2026", "Jun 2026", "Sep 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [9246000000.0, 10270000000.0, 10253000000.0, 11536000000.0, 13377000000.0]}, {"label": "Cost of Revenue", "kind": "money", "bold": false, "values": [4466000000.0, 4693000000.0, 4837000000.0, 5333000000.0, 6167000000.0]}, {"label": "Gross Profit", "kind": "money", "bold": true, "values": [4780000000.0, 5577000000.0, 5416000000.0, 6203000000.0, 7210000000.0]}, {"label": "Gross Margin %", "kind": "pct", "bold": false, "values": [0.5169803158122431, 0.5430379746835443, 0.5282356383497513, 0.5377080443828016, 0.5389848246991105]}, {"label": "R&D", "kind": "money", "bold": false, "values": [2139000000.0, 2330000000.0, 2397000000.0, 2528000000.0, 2803000000.0]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [1069000000.0, 1198000000.0, 1253000000.0, 1401000000.0, 1298000000.0]}, {"label": "Operating Expenses", "kind": "money", "bold": false, "values": [3510000000.0, 3