any has collaboration with to address AI infrastructure needs at the server and pod levels. Marvell Technology, Inc. was incorporated in 1995 and is headquartered in Wilmington, Delaware.", "sector": "Technology", "industry": "Semiconductors", "employees": 7480.0, "city": "Wilmington", "state": "DE", "country": "United States", "price": 121.15, "change_pct": -7.9197426, "quote_time": 1795620011.0, "market_cap": 109006635008.0, "net_assets": null, "high_52w": 329.88, "low_52w": 70.69, "pe": 39.851974, "forward_pe": 16.41957, "eps": 3.04, "book_value": 21.135, "price_to_book": 5.732197776200615, "dividend_yield": 0.0018, "roce": 0.1396162857063033, "roe": 0.16523, "roa": 0.04125, "net_margin": 0.27934998, "operating_margin": 0.16812, "revenue_growth": 0.365, "earnings_growth": 0.5, "debt_to_equity": 0.28525, "current_ratio": 3.168, "beta": 2.327}, "financials": {"quarterly": {"columns": ["Jul 2025", "Oct 2025", "Jan 2026", "Apr 2026", "Jul 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [2006100000.0, 2074500000.0, 2218700000.0, 2417800000.0, 2739300000.0]}, {"label": "Cost of Revenue", "kind": "money", "bold": false, "values": [995500000.0, 1004700000.0, 1070800000.0, 1157000000.0, 1283700000.0]}, {"label": "Gross Profit", "kind": "money", "bold": true, "values": [1010600000.0, 1069800000.0, 1147900000.0, 1260800000.0, 1455600000.0]}, {"label": "Gross Margin %", "kind": "pct", "bold": false, "values": [0.5037635212601566, 0.5156905278380333, 0.5173750394375084, 0.5214657953511457, 0.5313766290658197]}, {"label": "R&D", "kind": "money", "bold": false, "values": [519000000.0, 512500000.0, 536000000.0, 652300000.0, 741100000.0]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [192800000.0, 189900000.0, 198000000.0, 258400000.0, 257600000.0]}, {"label": "Operating Expenses", "kind": "money", "bold": false, "values": [711800000.0, 702400000.0, 734000000.0, 910700000.0, 998700000.0]}, {"label": "Operating Profit", "kind": "money