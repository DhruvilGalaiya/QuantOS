d glucose monitoring systems; and neuromodulation devices. The company was formerly known as Abbott Alkaloidal Company and changed its name to Abbott Laboratories in 1915. Abbott Laboratories was founded in 1888 and is based in Abbott Park, Illinois.", "sector": "Healthcare", "industry": "Medical Devices", "employees": 122000.0, "city": "Abbott Park", "state": "IL", "country": "United States", "price": 107.445, "change_pct": 1.9499006, "quote_time": 1795619889.0, "market_cap": 186088472576.0, "net_assets": null, "high_52w": 129.85, "low_52w": 81.97, "pe": 40.091415, "forward_pe": 18.11797, "eps": 2.68, "book_value": 29.462, "price_to_book": 3.6469010929332697, "dividend_yield": 0.0239, "roce": 0.09727998262663554, "roe": 0.09137999, "roa": 0.04902, "net_margin": 0.09747, "operating_margin": 0.15648, "revenue_growth": 0.145, "earnings_growth": -0.436, "debt_to_equity": 0.60899, "current_ratio": 1.455, "beta": 0.537}, "financials": {"quarterly": {"columns": ["Jun 2025", "Sep 2025", "Dec 2025", "Mar 2026", "Sep 2026"], "rows": [{"label": "Revenue", "kind": "money", "bold": false, "values": [11142000000.0, 11369000000.0, 11459000000.0, 11164000000.0, 13013000000.0]}, {"label": "Cost of Revenue", "kind": "money", "bold": false, "values": [4854000000.0, 5075000000.0, 4922000000.0, 4890000000.0, 5628000000.0]}, {"label": "Gross Profit", "kind": "money", "bold": true, "values": [6288000000.0, 6294000000.0, 6537000000.0, 6274000000.0, 7385000000.0]}, {"label": "Gross Margin %", "kind": "pct", "bold": false, "values": [0.5643511039310716, 0.5536106957516053, 0.5704686272798674, 0.5619849516302401, 0.5675094136632598]}, {"label": "R&D", "kind": "money", "bold": false, "values": [725000000.0, 766000000.0, 735000000.0, 767000000.0, 920000000.0]}, {"label": "SG&A", "kind": "money", "bold": false, "values": [3091000000.0, 3051000000.0, 3129000000.0, 3740000000.0, 4266000000.0]}, {"label": "Operating Expenses", "kind": "money", "bold": false, "values": [4236000000.0, 4237000000.0, 