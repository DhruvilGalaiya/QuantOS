{
  "name": "@quantos/gateway",
  "version": "1.0.0",
  "private": true,
  "description": "QuantOS Node gateway: the public API and security boundary in front of the Python quant service",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.3.0",
    "@quantos/types": "*",
    "fastify": "5.12.8",
    "lru-cache": "11.5.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26",
    "tsx": "4.23.15",
    "vitest": "5.1.2"
  }
}
